@page
@model LoanTracker.Pages.Queue.IndexModel
@{
    ViewData["Title"] = "Fulfillment Queue";
    var defaultDue = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd");
}

<h1 class="h3">Fulfillment queue</h1>
<p class="text-muted">Manager-approved requests waiting for you to assign an item and set a due date.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning">@Model.Message</div>
}

@if (Model.Approved.Any())
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Employee</th><th>Requested item</th><th>Requested</th><th style="width:420px">Fulfill</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Approved)
        {
            <tr>
                <td>@r.Requester.DisplayName</td>
                <td>@r.ItemDescription<br /><span class="text-muted small">@r.Category</span></td>
                <td>@r.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (Model.AvailableEquipment.Any())
                    {
                        <form method="post" asp-page-handler="Fulfill" class="d-flex gap-1 align-items-center">
                            <input type="hidden" name="requestId" value="@r.Id" />
                            <select name="equipmentId" class="form-select form-select-sm" required>
                                <option value="">Choose item…</option>
                                @foreach (var e in Model.AvailableEquipment)
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            </select>
                            <input type="date" name="dueDate" value="@defaultDue" class="form-control form-control-sm" required />
                            <button class="btn btn-sm btn-primary">Assign</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-danger small">No available equipment to assign.</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
else
{
    <p class="text-muted">The queue is empty. 🎉</p>
}
