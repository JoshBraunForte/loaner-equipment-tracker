@page
@model LoanTracker.Pages.Approvals.IndexModel
@{
    ViewData["Title"] = "Approvals";
}

<h1 class="h3">Requests awaiting your approval</h1>

@if (Model.Pending.Any())
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Employee</th><th>Item</th><th>Justification</th><th>Requested</th><th style="width:320px">Decision</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Pending)
        {
            <tr>
                <td>@r.Requester.DisplayName</td>
                <td>@r.ItemDescription<br /><span class="text-muted small">@r.Category</span></td>
                <td class="small">@r.Justification</td>
                <td>@r.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <form method="post" asp-page-handler="Decide" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@r.Id" />
                        <input type="text" name="note" class="form-control form-control-sm" placeholder="Note (optional)" />
                        <button name="decision" value="approve" class="btn btn-sm btn-success">Approve</button>
                        <button name="decision" value="deny" class="btn btn-sm btn-outline-danger">Deny</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
else
{
    <p class="text-muted">No requests are waiting on you right now.</p>
}

<h2 class="h5 mt-4">Recently decided</h2>
@if (Model.Decided.Any())
{
    <table class="table table-sm">
        <thead><tr><th>Employee</th><th>Item</th><th>Status</th><th>Decided</th><th>Note</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Decided)
        {
            <tr>
                <td>@r.Requester.DisplayName</td>
                <td>@r.ItemDescription</td>
                <td><partial name="_RequestStatusBadge" model="r.Status" /></td>
                <td>@(r.DecidedAt?.ToString("yyyy-MM-dd"))</td>
                <td class="small">@r.DecisionNote</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Nothing decided yet.</p>
}
