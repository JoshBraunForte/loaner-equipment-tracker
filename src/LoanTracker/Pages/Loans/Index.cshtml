@page
@model LoanTracker.Pages.Loans.IndexModel
@{
    ViewData["Title"] = "Active Loans";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="h3">Active loans</h1>
    <div class="btn-group">
        <a class="btn btn-sm @(Model.OverdueOnly ? "btn-outline-secondary" : "btn-secondary")" asp-page="/Loans/Index" asp-route-overdueOnly="false">All</a>
        <a class="btn btn-sm @(Model.OverdueOnly ? "btn-danger" : "btn-outline-danger")" asp-page="/Loans/Index" asp-route-overdueOnly="true">Overdue only</a>
    </div>
</div>

@if (Model.Active.Any())
{
    <table class="table table-hover mt-3 align-middle">
        <thead><tr><th>Asset</th><th>Item</th><th>Holder</th><th>Checked out</th><th>Due</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var l in Model.Active)
        {
            <tr class="@(l.IsOverdue ? "table-danger" : "")">
                <td>@l.Equipment.AssetTag</td>
                <td>@l.Equipment.Name</td>
                <td>@l.Borrower.DisplayName</td>
                <td>@l.CheckedOutAt.ToString("yyyy-MM-dd")</td>
                <td>@l.DueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (l.IsOverdue)
                    {
                        <span class="badge bg-danger">Overdue (@((DateTime.Today - l.DueDate.Date).Days)d)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">On time</span>
                    }
                </td>
                <td class="text-end">
                    <form method="post" asp-page-handler="CheckIn" asp-route-id="@l.Id" asp-route-overdueOnly="@Model.OverdueOnly">
                        <button class="btn btn-sm btn-outline-primary">Check in</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">@(Model.OverdueOnly ? "Nothing overdue. 🎉" : "No active loans.")</p>
}
