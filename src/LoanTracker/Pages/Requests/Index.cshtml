@page
@model LoanTracker.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "My Requests";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="h3">My Requests</h1>
    <a class="btn btn-primary" asp-page="/Requests/Create">+ New request</a>
</div>

@if (Model.Requests.Any())
{
    <table class="table table-hover mt-3">
        <thead><tr><th>Item</th><th>Category</th><th>Requested</th><th>Status</th><th>Manager note</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Requests)
        {
            <tr>
                <td>@r.ItemDescription</td>
                <td>@r.Category</td>
                <td>@r.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td><partial name="_RequestStatusBadge" model="r.Status" /></td>
                <td>@r.DecisionNote</td>
                <td class="text-end">
                    @if (r.Status == RequestStatus.Submitted)
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id">
                            <button class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">You haven't made any requests yet.</p>
}
